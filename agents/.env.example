# Port the Bureau process (python -m src.bureau) serves both agents on.
# A uagents Bureau shares one HTTP server across all its agents, so the workout
# and meal agents are told apart by REST path, not port. Must match the port in
# backend/.env's WORKOUT_AGENT_URL / MEAL_AGENT_URL.
BUREAU_PORT=8000

# Only used if running an agent standalone (e.g. `python -m src.workout_agent`)
# instead of via the Bureau. Ignored when run through the Bureau.
WORKOUT_AGENT_PORT=8001
MEAL_AGENT_PORT=8002
