# Firebase Web SDK config (required in every environment, including local
# development). From Firebase Console > Project Settings > General > Your apps
# > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the FitForge backend API
VITE_API_BASE_URL=http://localhost:4000

# --- Local development only ---
# Leave VITE_USE_FIREBASE_EMULATOR unset (or "false") in every deployed
# environment so the app always talks to the real Firebase Auth service.
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
