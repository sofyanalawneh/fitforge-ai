# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK service account (required in every environment, including
# local development). Generate one at:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes when pasting the private key into a single-line env var
FIREBASE_PRIVATE_KEY=

# Fetch.ai agent endpoints. Both agents run inside one Bureau process sharing a
# single port (see agents/.env.example BUREAU_PORT); distinct paths select the
# workout vs. meal agent.
WORKOUT_AGENT_URL=http://localhost:8000/workout/generate
MEAL_AGENT_URL=http://localhost:8000/meal/generate
AGENT_REQUEST_TIMEOUT_MS=30000

# --- Local development only ---
# Leave USE_FIREBASE_EMULATOR unset (or "false") in every deployed environment.
# When it is not exactly "true", the two emulator host vars below are ignored
# even if present, so production can never be accidentally redirected to a
# local emulator.
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
